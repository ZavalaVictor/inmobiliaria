#!/usr/bin/env php
<?php

use Illuminate\Foundation\Application;
use Symfony\Component\Console\Input\ArgvInput;

define('LARAVEL_START', microtime(true));

// The CLI server does not load public/.user.ini, so ensure the PHP process
// created by `php artisan serve` accepts the same image upload size as the
// application validation rules.
if (($argv[1] ?? null) === 'serve') {
    $uploadAwarePhp = __DIR__.'/bin/php-upload-server';

    if (is_executable($uploadAwarePhp)) {
        putenv('PHP_BINARY='.$uploadAwarePhp);
    }
}

// Register the Composer autoloader...
require __DIR__.'/vendor/autoload.php';

// Bootstrap Laravel and handle the command...
/** @var Application $app */
$app = require_once __DIR__.'/bootstrap/app.php';

$status = $app->handleCommand(new ArgvInput);

exit($status);
